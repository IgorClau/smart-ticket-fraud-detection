# Ambiente Spark + Delta para validar os notebooks Databricks fora da nuvem
# (usado pelo serviço `spark` do docker-compose, perfil "spark").
# O repositório é montado em /workspace; nada de código é copiado para a imagem.
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends default-jre-headless procps \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PYSPARK_PYTHON=python SPARK_DRIVER_MEMORY=6g

COPY requirements-spark.txt /tmp/requirements-spark.txt
RUN pip install -r /tmp/requirements-spark.txt

# baixa os jars do Delta uma vez, na construção da imagem
RUN python -c "from pyspark.sql import SparkSession; from delta import configure_spark_with_delta_pip as c; \
s = c(SparkSession.builder.master('local[1]')).getOrCreate(); print(s.version); s.stop()"

WORKDIR /workspace
