{
  "name": "Smart Ticket - escuro pastel",
  "dataColors": ["#8FB8DE", "#F4A6A6", "#A8D5BA", "#F7D59C", "#C3B1E1", "#9ADCDC", "#F2B5D4", "#C9D6A3"],
  "foreground": "#E6E9EF",
  "foregroundNeutralSecondary": "#B7BDCA",
  "foregroundNeutralTertiary": "#8A91A0",
  "background": "#2B2F3A",
  "backgroundLight": "#353A47",
  "backgroundNeutral": "#454B5A",
  "backgroundDark": "#232631",
  "secondaryBackground": "#3E4454",
  "tableAccent": "#8FB8DE",
  "accent": "#8FB8DE",
  "good": "#A8D5BA",
  "neutral": "#F7D59C",
  "bad": "#F4A6A6",
  "maximum": "#F4A6A6",
  "center": "#F7D59C",
  "minimum": "#A8D5BA",
  "null": "#8A91A0",
  "hyperlink": "#9ADCDC",
  "visitedHyperlink": "#C3B1E1",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#F1F3F7" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#E6E9EF" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#E6E9EF" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#C9CED8" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#2B2F3A" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#232631" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#353A47" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#454B5A" } }, "radius": 12 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }],
        "title": [{ "fontColor": { "solid": { "color": "#E6E9EF" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }],
        "categoryAxis": [{
          "labelColor": { "solid": { "color": "#B7BDCA" } },
          "titleColor": { "solid": { "color": "#B7BDCA" } },
          "gridlineColor": { "solid": { "color": "#454B5A" } }
        }],
        "valueAxis": [{
          "labelColor": { "solid": { "color": "#B7BDCA" } },
          "titleColor": { "solid": { "color": "#B7BDCA" } },
          "gridlineColor": { "solid": { "color": "#454B5A" } },
          "secLabelColor": { "solid": { "color": "#B7BDCA" } }
        }],
        "legend": [{ "labelColor": { "solid": { "color": "#C9CED8" } } }],
        "labels": [{ "color": { "solid": { "color": "#E6E9EF" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#F1F3F7" } }, "fontSize": 26 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#B7BDCA" } } }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#454B5A" } }, "rowPadding": 4 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#E6E9EF" } }, "backColor": { "solid": { "color": "#3E4454" } } }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#E6E9EF" } }, "backColorPrimary": { "solid": { "color": "#353A47" } },
          "fontColorSecondary": { "solid": { "color": "#E6E9EF" } }, "backColorSecondary": { "solid": { "color": "#3A3F4D" } }
        }],
        "total": [{ "fontColor": { "solid": { "color": "#F1F3F7" } }, "backColor": { "solid": { "color": "#3E4454" } } }]
      }
    },
    "slicer": {
      "*": {
        "items": [{ "fontColor": { "solid": { "color": "#E6E9EF" } }, "background": { "solid": { "color": "#3E4454" } } }],
        "header": [{ "fontColor": { "solid": { "color": "#E6E9EF" } } }],
        "padding": [{ "top": 4, "bottom": 4, "left": 8, "right": 8 }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "padding": [{ "top": 0, "bottom": 0, "left": 0, "right": 0 }]
      }
    }
  }
}
